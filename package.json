{
  "name": "meeting-app",
  "version": "0.1.0",
  "description": "회의 화면·시스템 사운드·마이크 녹화 + 입력 이벤트 기록",
  "main": "./out/main/index.js",
  "author": "dlee@upgrademfg.com",
  "private": true,
  "scripts": {
    "postinstall": "yarn build:native",
    "build:native": "node-gyp rebuild --directory native",
    "dev": "electron-vite dev",
    "build": "yarn typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:mac": "yarn build:native && yarn build && electron-builder --mac",
    "dist:win": "yarn build:native && yarn build && electron-builder --win"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependenciesMeta": {
    "ffmpeg-static": {
      "built": true
    },
    "fsevents": {
      "built": true
    },
    "uiohook-napi": {
      "built": true
    }
  },
  "packageManager": "yarn@4.18.1"
}

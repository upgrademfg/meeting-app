{
  "name": "meeting-app",
  "version": "0.1.0",
  "description": "회의 화면·시스템 사운드·마이크 녹화 + 입력 이벤트 기록",
  "main": "./out/main/index.js",
  "author": "dlee@upgrademfg.com",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "get-windows": "^10.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "get-windows@10.0.0": true,
    "uiohook-napi@1.5.5": true,
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": true
  }
}
